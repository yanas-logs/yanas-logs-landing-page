---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-[#fcfbf9] text-[#111111] font-serif">
		<Header />
		
		<main class="max-w-3xl mx-auto px-4 py-8">
			
			<div class="text-center border-y-2 border-black py-5 mb-8">
				<h1 class="text-2xl font-bold tracking-tight uppercase font-newspaper-title">Yana Suryana</h1>
				<p class="text-xs text-gray-700 mt-1">Creator</p>
			</div>

			<section>
				<h2 class="text-xs uppercase font-bold tracking-widest border-b border-black pb-1 mb-6">
					Latest Dispatches
				</h2>
				
				<ul class="space-y-6">
					{posts.map((post) => (
						<li class="border-b border-gray-300 pb-4">
							<div class="text-xs text-gray-500 mb-1 font-sans">
								<FormattedDate date={post.data.pubDate} />
							</div>
							<h3 class="text-base font-bold mb-1">
								<a href={`/blog/${post.id}/`} class="text-[#111111] no-underline hover:underline font-newspaper-title">
									{post.data.title}
								</a>
							</h3>
							<p class="text-xs text-gray-800 font-newspaper-body leading-normal line-clamp-2">
								{post.data.description}
							</p>
						</li>
					))}
				</ul>
			</section>

		</main>
		<Footer />
	</body>
</html>