---
import { SITE_TITLE, SITE_TAGLINE } from '../consts';

const { pathname } = Astro.url;
const nav = [
  { href: '/', label: 'Front Page' },
  { href: '/blog', label: 'Dispatches' },
  { href: '/projects', label: 'Features' },
  { href: '/about', label: 'Profile' },
  { href: '/contact', label: 'Letters' },
];
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const fmt = new Intl.DateTimeFormat('id-ID', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
});
const today = fmt.format(new Date());
---

<header class="border-b-4 border-double border-ink">
  <div class="mx-auto max-w-6xl px-4">
    <div class="flex items-center justify-between border-b border-rule py-2 font-ui text-[11px] uppercase tracking-widest text-muted">
      <span>Vol. 1 · No. 1</span>
      <time id="today" class="hidden sm:block">{today}</time>
      <span>Digital Edition</span>
    </div>

    <div class="py-6 text-center">
      <a href="/" class="font-newspaper-title text-5xl font-black tracking-tight no-underline text-ink md:text-7xl">
        {SITE_TITLE}
      </a>
      <p class="mt-1 italic text-muted">{SITE_TAGLINE}</p>
    </div>

    <nav aria-label="Navigation" class="border-t border-ink">
      <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-1 py-2 font-ui text-xs font-semibold uppercase tracking-[0.18em]">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'no-underline text-ink hover:underline underline-offset-4',
                isActive(item.href) && 'underline decoration-2',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const el = document.getElementById('today');
  if (el) {
    el.textContent = new Intl.DateTimeFormat('id-ID', {
      weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
    }).format(new Date());
  }
</script>

